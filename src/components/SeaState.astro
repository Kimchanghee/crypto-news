---
// Build-time SVG: mempool backlog (in 1 MvB blocks) on a log scale with the five
// congestion bands defined on /methodology/.
interface Props { blocks: number; label: string }
const { blocks, label } = Astro.props;
const W = 720, H = 92, padL = 8, padR = 8, top = 30, bandH = 22;
const max = 100;
const x = (v: number) => padL + (Math.log10(Math.max(0.1, Math.min(max, v))) + 1) / 3 * (W - padL - padR);
const bands = [
  { from: 0.1, to: 1, name: 'Calm', fill: '#dfe8ee' },
  { from: 1, to: 3, name: 'Light swell', fill: '#c7d7e2' },
  { from: 3, to: 10, name: 'Choppy', fill: '#a9c0d1' },
  { from: 10, to: 30, name: 'Rough', fill: '#7f9db5' },
  { from: 30, to: 100, name: 'Storm', fill: '#4f6f8a' },
];
const mx = x(blocks);
const ticks = [0.1, 1, 3, 10, 30, 100];
---
<figure class="seastate">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="sea-title sea-desc">
    <title id="sea-title">Mempool backlog: {blocks.toFixed(1)} blocks ({label})</title>
    <desc id="sea-desc">Log-scale band chart from 0.1 to 100 blocks of pending transactions, with the current reading marked.</desc>
    {bands.map((b) => (
      <g>
        <rect x={x(b.from)} y={top} width={x(b.to) - x(b.from)} height={bandH} fill={b.fill} />
        <text x={(x(b.from) + x(b.to)) / 2} y={top + bandH + 16} text-anchor="middle" font-family="ui-monospace, Consolas, monospace" font-size="12" fill="#46505c">{b.name}</text>
      </g>
    ))}
    {ticks.map((t) => <line x1={x(t)} x2={x(t)} y1={top} y2={top + bandH} stroke="#f4efe3" stroke-width="1.5" />)}
    <line x1={mx} x2={mx} y1={top - 14} y2={top + bandH + 2} stroke="#a8322a" stroke-width="3" />
    <text x={Math.min(Math.max(mx, 60), W - 60)} y={top - 18} text-anchor="middle" font-family="ui-monospace, Consolas, monospace" font-size="13" font-weight="700" fill="#a8322a">{blocks.toFixed(1)} blocks</text>
  </svg>
</figure>
