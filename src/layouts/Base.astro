---
import { site } from '../site.config';
import '../styles/global.css';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  path: string; // e.g. '/guides/rbf/'
  og?: string; // og image slug in /og/
  ld?: Record<string, unknown>[];
  crumbs?: Crumb[];
  type?: 'website' | 'article';
  modified?: string;
}
const { title, description, path, og = 'default', ld = [], crumbs = [], type = 'website', modified } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = `${site.url}/og/${og}.png`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#org`,
  name: site.name,
  url: site.url + '/',
  logo: `${site.url}/favicon.svg`,
  email: site.contactEmail,
  description: site.entity,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url + '/',
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#org` },
};
const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.path, site.url).href,
      })),
    }
  : null;
const allLd = [org, website, ...(breadcrumb ? [breadcrumb] : []), ...ld];
const consentRegions = ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH'];
const nav = [
  { href: '/', label: 'Today' },
  { href: '/log/', label: 'Log' },
  { href: '/tools/btc-fee-estimator/', label: 'Fee estimator' },
  { href: '/tools/halving-countdown/', label: 'Countdowns' },
  { href: '/guides/', label: 'Guides' },
  { href: '/methodology/', label: 'Method' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#f4efe3" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Daily Crypto News guides" href="/rss.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={site.locale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {modified && <meta property="article:modified_time" content={modified} />}
  {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
  <meta name="google-adsense-account" content={site.adsenseClient} />
  <script is:inline define:vars={{ regions: consentRegions, ga4: site.ga4Id }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',region:regions,wait_for_update:500});
    gtag('consent','default',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});
    if (ga4) { gtag('js', new Date()); gtag('config', ga4); }
    window.dcnTrack = function(name, params){ if (ga4) gtag('event', name, params || {}); };
  </script>
  {site.ga4Id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>}
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>
  {allLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <div class="masthead__inner">
      <a class="brand" href="/" aria-label="Daily Crypto News home">
        <span class="brand__name">Daily Crypto News</span>
        <span class="brand__sub">Bitcoin &amp; Ethereum network log</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav">
          {nav.map((n) => (
            <li><a href={n.href} aria-current={(n.href === '/' ? current === '/' : current.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  {crumbs.length > 0 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {crumbs.map((c, i) => (i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={c.path}>{c.name}</a></li>))}
      </ol>
    </nav>
  )}
  <main id="main" class="sheet">
    <slot />
  </main>
  <footer class="colophon">
    <div class="colophon__inner">
      <p class="colophon__entity">{site.entity}</p>
      <ul class="colophon__links">
        <li><a href="/about/">About</a></li>
        <li><a href="/methodology/">Methodology &amp; sources</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
      <p class="colophon__small">Not financial, tax or legal advice. No exchange or token promotion; this site carries no affiliate links. Data: mempool.space, Binance public market data, Ethereum JSON-RPC. Ads by Google AdSense.</p>
    </div>
  </footer>
</body>
</html>
