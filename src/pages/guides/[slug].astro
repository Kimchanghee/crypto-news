---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const d = g.data;
const path = `/guides/${g.id}/`;
const all = (await getCollection('guides')).filter((x) => x.id !== g.id).sort((a, b) => a.data.title.localeCompare(b.data.title));
const related = all.slice(0, 4);
const ld: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.h1,
  description: d.description,
  datePublished: d.published,
  dateModified: d.updated,
  inLanguage: 'en',
  mainEntityOfPage: site.url + path,
  image: `${site.url}/og/guide-${g.id}.png`,
  author: { '@type': 'Organization', name: site.name, url: site.url + '/' },
  publisher: { '@id': `${site.url}/#org` },
  citation: d.sources.map((s) => s.url),
}];
if (d.faq.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} path={path} og={`guide-${g.id}`} ld={ld} type="article" modified={d.updated} crumbs={[{ name: 'Guides', path: '/guides/' }, { name: d.kicker, path }]}>
  <article class="entry">
    <div class="entry__mark">
      <span>{d.kicker}</span>
      <span>Updated <time datetime={d.updated}>{d.updated}</time></span>
      <span>Facts as of {d.data_asof}</span>
    </div>
    <div class="entry__body prose">
      <h1>{d.h1}</h1>
      <p class="answer" id="answer">{d.answer}</p>
      <Content />
      {d.faq.length > 0 && (
        <section aria-labelledby="faq-h">
          <h2 id="faq-h">Questions people also ask</h2>
          <dl class="faq">
            {d.faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
          </dl>
        </section>
      )}
      <section class="sources" aria-labelledby="src-h">
        <h2 id="src-h">Sources</h2>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ol>
        <p>Written and checked by the Daily Crypto News editors. Published {d.published}; last reviewed {d.updated}. See our <a href="/about/#standards">editorial standards</a>. Not financial, tax or legal advice.</p>
      </section>
      <section aria-labelledby="rel-h">
        <h2 id="rel-h">Related in the log</h2>
        <ul>
          <li><a href="/">Today’s network log</a> — current fee tiers in dollars</li>
          {related.map((x) => <li><a href={`/guides/${x.id}/`}>{x.data.h1}</a></li>)}
        </ul>
      </section>
    </div>
  </article>
</Base>
